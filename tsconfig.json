{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react",
    "strict": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  // Les Edge Functions tournent sous Deno, pas sous React Native : globales (`Deno`),
  // imports (`jsr:`) et lib standard n'ont rien à voir avec ceux de l'app.
  // Elles sont typées par le toolchain Deno / Supabase CLI, pas par ce tsconfig.
  "exclude": ["supabase/functions"]
}
