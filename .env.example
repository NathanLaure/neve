# Supabase Configuration
# Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Clé service_role — accès total à la base, contourne le RLS.
# Utilisée UNIQUEMENT par les scripts d'ingestion (scripts/supabase-admin.ts),
# jamais par l'app. Ne jamais la préfixer EXPO_PUBLIC_ ni la commiter.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Mapbox Configuration
# Token public (pk.*) — utilisé par l'app au runtime
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here
# Token secret (sk.*) avec le scope DOWNLOADS:READ — utilisé au build par @rnmapbox/maps
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=your_mapbox_download_token_here
